---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Connect with Us"
  description="There are many ways to participate in the ongoing ministry of Victorious Christian Life Ministries — through prayer, fellowship, and financial support."
>

  <!-- Hero -->
  <section class="bg-forest-900 text-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-[var(--color-gold-light)] text-xs tracking-widest uppercase mb-3">Participation</p>
      <h1 class="font-serif text-5xl md:text-6xl" style="font-family: var(--font-serif)">Connect with Us</h1>
    </div>
  </section>

  <div class="max-w-3xl mx-auto px-6 py-16 space-y-20">

    <!-- Opening -->
    <p class="text-lg text-gray-700 leading-relaxed border-l-4 border-[var(--color-gold)] pl-6">
      Rev. Koye-Ladele gave over 30 years to this congregation. The work he started continues — and there are many ways you can be part of it.
    </p>

    <!-- 1. Pray -->
    <section class="space-y-5">
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-forest-50 border border-forest-100 flex items-center justify-center flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-forest-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </div>
        <h2 class="font-serif text-3xl text-forest-900" style="font-family: var(--font-serif)">Pray for Us</h2>
      </div>

      <p class="text-gray-700 leading-relaxed">
        The most powerful thing you can do for this ministry is pray. We believe with James 5:16 that <em>"the effectual fervent prayer of a righteous man availeth much"</em> — and we are grateful for every prayer lifted on our behalf.
      </p>

      <div class="bg-forest-50 rounded-lg p-6 border border-forest-100">
        <p class="text-xs text-forest-500 uppercase tracking-widest mb-3">Please pray for</p>
        <ul class="space-y-2 text-sm text-forest-800">
          <li class="flex items-start gap-2">
            <span class="text-[var(--color-gold)] mt-0.5">—</span>
            The leadership and congregation of Victorious Christian Life Ministries
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[var(--color-gold)] mt-0.5">—</span>
            The families Rev. Koye-Ladele served and continues to serve through this ministry
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[var(--color-gold)] mt-0.5">—</span>
            The growth and further establishment of God's church in the mission fields of South Western Nigeria
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[var(--color-gold)] mt-0.5">—</span>
            Growth, unity, and the reaching of the next generation
          </li>
        </ul>
      </div>
    </section>

    <hr class="border-[var(--color-cream-dark)]" />

    <!-- 2. Give -->
    <section class="space-y-5">
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-forest-50 border border-forest-100 flex items-center justify-center flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-forest-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h2 class="font-serif text-3xl text-forest-900" style="font-family: var(--font-serif)">Give Financially</h2>
      </div>

      <p class="text-gray-700 leading-relaxed">
        Running a church has real costs: community outreach, providing for God's people, and putting together our programmes. If you have been blessed by this ministry and would like to contribute financially, we are grateful.
      </p>

      <div class="bg-white rounded-lg border border-[var(--color-cream-dark)] p-6 space-y-4">
        <p class="text-xs text-gray-400 uppercase tracking-wide">Bank Transfer Details</p>
        <div class="space-y-3 text-sm">
          <div class="flex justify-between items-center py-2 border-b border-[var(--color-cream-dark)]">
            <span class="text-gray-500">Account Name</span>
            <span class="text-forest-900 font-medium text-right">Edward Koye-Ladele Publications and Expressions</span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-[var(--color-cream-dark)]">
            <span class="text-gray-500">Bank</span>
            <span class="text-forest-900 font-medium">UBA</span>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-gray-500">Account Number</span>
            <span class="text-forest-900 font-medium tracking-wider">1025776204</span>
          </div>
        </div>
      </div>
    </section>

    <hr class="border-[var(--color-cream-dark)]" />

    <!-- 3. Visit -->
    <section class="space-y-5">
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-forest-50 border border-forest-100 flex items-center justify-center flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-forest-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h2 class="font-serif text-3xl text-forest-900" style="font-family: var(--font-serif)">Come and Visit</h2>
      </div>

      <p class="text-gray-700 leading-relaxed">
        If you're ever in Ibadan, we'd love to see you. Come and experience the warmth of the congregation and the continuation of the same spirit of worship and teaching that shaped this ministry.
      </p>

      <div class="bg-white rounded-lg border border-[var(--color-cream-dark)] divide-y divide-[var(--color-cream-dark)]">
        <div class="p-6">
          <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">Church</p>
          <p class="text-forest-900 font-medium">Victorious Christian Life Ministries</p>
        </div>
        <div class="p-6">
          <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">Address</p>
          <a
            href="https://maps.app.goo.gl/QfzWCZCfqjiMjcbA9"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-700 hover:text-[var(--color-gold)] transition-colors underline underline-offset-2 decoration-gray-300 hover:decoration-[var(--color-gold)]"
          >
            No 34B, Bode Kumapayi Street<br />Iwo Road, Ibadan, Nigeria
          </a>
        </div>
        <div class="p-6">
          <p class="text-xs text-gray-400 uppercase tracking-wide mb-2">Services</p>
          <ul class="space-y-1 text-sm text-gray-700">
            <li class="flex justify-between">
              <span>Sunday</span>
              <span class="text-forest-700 font-medium">9:00 AM</span>
            </li>
            <li class="flex justify-between">
              <span>Monday</span>
              <span class="text-forest-700 font-medium">5:30 PM</span>
            </li>
            <li class="flex justify-between">
              <span>Wednesday</span>
              <span class="text-forest-700 font-medium">5:30 PM</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <hr class="border-[var(--color-cream-dark)]" />

    <!-- 4. Stay Connected -->
    <section class="space-y-5">
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-forest-50 border border-forest-100 flex items-center justify-center flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-forest-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <h2 class="font-serif text-3xl text-forest-900" style="font-family: var(--font-serif)">Stay Connected</h2>
      </div>

      <p class="text-gray-700 leading-relaxed">
        We'd love to hear from you — especially if Rev. Koye-Ladele's ministry touched your life. Use the form below to reach the leadership.
      </p>

      <!-- Success message (hidden by default) -->
      <div id="form-success" class="hidden bg-forest-50 border border-forest-200 rounded-lg p-6 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-forest-600 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
        </svg>
        <p class="text-forest-800 font-medium">Message sent. Thank you for reaching out.</p>
        <p class="text-sm text-forest-600 mt-1">We'll be in touch with you soon.</p>
      </div>

      <!-- Error message (hidden by default) -->
      <div id="form-error" class="hidden bg-red-50 border border-red-200 rounded-lg p-4 text-sm text-red-700">
        Something went wrong — please try again or email the ministry directly.
      </div>

      <form
        id="contact-form"
        class="space-y-5 bg-white rounded-lg border border-[var(--color-cream-dark)] p-8"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="name" class="block text-xs text-gray-400 uppercase tracking-wide mb-2">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full border border-gray-200 rounded-md px-4 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-forest-500 focus:ring-1 focus:ring-forest-500 transition"
              placeholder="Your name"
            />
          </div>
          <div>
            <label for="email" class="block text-xs text-gray-400 uppercase tracking-wide mb-2">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              data-fs-field
              class="w-full border border-gray-200 rounded-md px-4 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-forest-500 focus:ring-1 focus:ring-forest-500 transition"
              placeholder="your@email.com"
            />
            <span data-fs-error="email" class="text-xs text-red-600 mt-1 block"></span>
          </div>
        </div>

        <div>
          <label for="message" class="block text-xs text-gray-400 uppercase tracking-wide mb-2">Message</label>
          <textarea
            id="message"
            name="message"
            required
            data-fs-field
            rows="5"
            class="w-full border border-gray-200 rounded-md px-4 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-forest-500 focus:ring-1 focus:ring-forest-500 transition resize-none"
            placeholder="Your message to the leadership…"
          ></textarea>
          <span data-fs-error="message" class="text-xs text-red-600 mt-1 block"></span>
        </div>

        <button
          type="submit"
          id="submit-btn"
          data-fs-submit-btn
          class="bg-forest-900 text-white text-sm px-8 py-3 rounded-md hover:bg-forest-800 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Send Message
        </button>
      </form>
    </section>

    <!-- Closing -->
    <div class="text-center py-8 border-t border-[var(--color-cream-dark)]">
      <p class="text-forest-600 italic font-serif text-xl leading-relaxed" style="font-family: var(--font-serif)">
        Whatever form your participation takes,<br />thank you for keeping this work alive.
      </p>
    </div>

  </div>

</Layout>

<script>
  import { initForm } from '@formspree/ajax';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');

  if (form) {
    initForm({
      formElement: '#contact-form',
      formId: 'xdabrvyz',
    });

    form.addEventListener('formspree:success', () => {
      form.classList.add('hidden');
      successMsg?.classList.remove('hidden');
      errorMsg?.classList.add('hidden');
    });

    form.addEventListener('formspree:error', () => {
      errorMsg?.classList.remove('hidden');
    });
  }
</script>
